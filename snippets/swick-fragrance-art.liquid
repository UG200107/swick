{%- doc -%}
  Animated botanical illustrations for the "Shop by Fragrance" stage.
  Every animated element carries class "sfa-a". Animations only run while an ancestor
  has class "is-playing" (set by <swick-fragrance> in assets/swick.js), so re-adding that
  class replays the growth. Reduced-motion users see the finished illustration.

  @param {string} type - lavender | rose | jasmine | sandalwood | ocean | sprig | art-lavender | art-jasmine (your artwork)

  @example
  {% render 'swick-fragrance-art', type: 'lavender' %}
{%- enddoc -%}

{%- if type contains 'art-' -%}
  {%- comment -%} Your lavender artwork, vectorised so every bud, stem and leaf animates on its own. {%- endcomment -%}
  <div class="sfx" aria-hidden="true">
    {%- case type -%}
      {%- when 'art-jasmine' -%}{%- render 'swick-frag-jasmine-art' -%}
      {%- else -%}{%- render 'swick-frag-lavender-art' -%}
    {%- endcase -%}
  </div>
{%- else -%}
<svg class="sfa" viewBox="64 22 192 218" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMax meet">
  <ellipse class="sfa-ground" cx="160" cy="231" rx="96" ry="7"/>

  {%- case type -%}
    {%- when 'lavender' -%}
      <g class="sfa-sway" style="--sway-d: 2.95s;">
        {%- comment -%} Base leaves {%- endcomment -%}
        <path class="sfa-a sfa-pop" style="--d: 0.15s;" d="M158 226c-16-6-26-22-28-40 14 8 24 22 28 40Z" fill="#8e9f74"/>
        <path class="sfa-a sfa-pop" style="--d: 0.25s;" d="M162 226c16-6 26-22 28-40-14 8-24 22-28 40Z" fill="#7d8f63"/>
        <path class="sfa-a sfa-pop" style="--d: 0.3s;" d="M150 228c-22-2-38-14-46-30 18 2 34 12 46 30Z" fill="#9aab80"/>
        <path class="sfa-a sfa-pop" style="--d: 0.35s;" d="M170 228c22-2 38-14 46-30-18 2-34 12-46 30Z" fill="#8a9b6f"/>

        {%- comment -%} Three stalks: x, top, start delay {%- endcomment -%}
        {%- assign stalks = '122,96,0.2|160,58,0|198,82,0.35' | split: '|' -%}
        {%- for stalk in stalks -%}
          {%- liquid
            assign parts = stalk | split: ','
            assign sx = parts[0] | plus: 0
            assign top = parts[1] | plus: 0
            assign base_d = parts[2] | plus: 0
            assign c1y = top | plus: 70
            assign sxl = sx | minus: 4
          -%}
          <path class="sfa-a sfa-grow" style="--d: {{ base_d }}s; --t: 1.1s;" pathLength="1" d="M{{ sx }} 228C{{ sx }} 196 {{ sxl }} {{ c1y }} {{ sx }} {{ top }}" fill="none" stroke="#6f8152" stroke-width="2.6" stroke-linecap="round"/>
          {%- for i in (0..9) -%}
            {%- liquid
              assign step = i | times: 7
              assign by = top | plus: step
              assign side = i | modulo: 2
              if side == 0
                assign bx = sx | minus: 4
                assign rot = -18
              else
                assign bx = sx | plus: 4
                assign rot = 18
              endif
              assign from_bottom = 9 | minus: i
              assign bd = from_bottom | times: 0.08 | plus: base_d | plus: 1.0
              assign shade = i | modulo: 3
            -%}
            <g transform="translate({{ bx }} {{ by }}) rotate({{ rot }})">
              <ellipse class="sfa-a sfa-pop" style="--d: {{ bd }}s; --o: 50% 50%;" cx="0" cy="0" rx="4.2" ry="6.4" fill="{% case shade %}{% when 0 %}#8a74c9{% when 1 %}#9f8bdb{% else %}#7561b5{% endcase %}"/>
            </g>
          {%- endfor -%}
          <circle class="sfa-a sfa-pop" style="--d: {{ base_d | plus: 1.85 }}s; --o: 50% 50%;" cx="{{ sx }}" cy="{{ top | minus: 3 }}" r="3.4" fill="#b3a3e6"/>
        {%- endfor -%}
      </g>

    {%- when 'rose' -%}
      <g class="sfa-sway" style="--sway-d: 2.75s;">
        <path class="sfa-a sfa-grow" style="--t: 1.1s;" pathLength="1" d="M160 228C165 196 154 152 160 106" fill="none" stroke="#5d7a46" stroke-width="3.4" stroke-linecap="round"/>
        <path class="sfa-a sfa-pop" style="--d: 0.55s; --o: 100% 0%;" d="M159 200l-6-3 6-2Z" fill="#5d7a46"/>
        <path class="sfa-a sfa-pop" style="--d: 0.75s; --o: 0% 100%;" d="M160 162l6-3-6-2Z" fill="#5d7a46"/>
        <path class="sfa-a sfa-pop" style="--d: 0.7s; --o: 100% 0%;" d="M157 182c-20-2-36-12-42-28 18 0 34 10 42 28Z" fill="#6f8f55"/>
        <path class="sfa-a sfa-pop" style="--d: 0.9s; --o: 0% 100%;" d="M161 146c20-4 32-16 36-30-18 2-30 12-36 30Z" fill="#7d9c62"/>
        <path class="sfa-a sfa-pop" style="--d: 1.05s;" d="M150 108c4-8 8-10 10-10s6 2 10 10c-6-3-14-3-20 0Z" fill="#5d7a46"/>
        {%- comment -%} Bloom centred at 160,90: outer, middle and inner petals {%- endcomment -%}
        {%- for i in (0..5) -%}
          {%- assign a = i | times: 60 -%}
          {%- assign d = i | times: 0.06 | plus: 1.2 -%}
          <g transform="rotate({{ a }} 160 90)">
            <ellipse class="sfa-a sfa-bloom" style="--d: {{ d }}s; --o: 50% 100%;" cx="160" cy="74" rx="13" ry="17" fill="#e57d93"/>
          </g>
        {%- endfor -%}
        {%- for i in (0..4) -%}
          {%- assign a = i | times: 72 | plus: 36 -%}
          {%- assign d = i | times: 0.06 | plus: 1.55 -%}
          <g transform="rotate({{ a }} 160 90)">
            <ellipse class="sfa-a sfa-bloom" style="--d: {{ d }}s; --o: 50% 100%;" cx="160" cy="80" rx="10" ry="12" fill="#d45a75"/>
          </g>
        {%- endfor -%}
        <circle class="sfa-a sfa-bloom" style="--d: 1.85s; --o: 50% 50%;" cx="160" cy="90" r="9" fill="#bb4460"/>
        <path class="sfa-a sfa-grow" style="--d: 2s; --t: 0.6s;" pathLength="1" d="M160 90c3-3 6 0 4 3-2 4-8 3-9-1-1-5 4-9 9-8" fill="none" stroke="#8e2f47" stroke-width="1.4" stroke-linecap="round"/>
      </g>

    {%- when 'jasmine' -%}
      <g class="sfa-sway" style="--sway-d: 3s;">
        <path class="sfa-a sfa-grow" style="--t: 1.3s;" pathLength="1" d="M150 228C150 190 172 160 160 122 152 92 172 72 194 58" fill="none" stroke="#5f7748" stroke-width="2.8" stroke-linecap="round"/>
        <path class="sfa-a sfa-grow" style="--d: 0.6s; --t: 0.8s;" pathLength="1" d="M156 172C140 162 120 152 106 128" fill="none" stroke="#5f7748" stroke-width="2.2" stroke-linecap="round"/>
        <path class="sfa-a sfa-grow" style="--d: 0.8s; --t: 0.8s;" pathLength="1" d="M162 132C184 126 204 112 216 92" fill="none" stroke="#5f7748" stroke-width="2.2" stroke-linecap="round"/>
        {%- comment -%} Leaves: x, y, rotation, delay {%- endcomment -%}
        {%- assign leaves = '152,200,-40,0.5|158,178,30,0.65|132,160,-60,0.9|118,140,-20,1.05|166,150,40,0.95|186,124,10,1.1|170,110,-35,1.15|204,104,45,1.25|182,74,-10,1.3' | split: '|' -%}
        {%- for leaf in leaves -%}
          {%- assign p = leaf | split: ',' -%}
          <g transform="translate({{ p[0] }} {{ p[1] }}) rotate({{ p[2] }})">
            <path class="sfa-a sfa-pop" style="--d: {{ p[3] }}s; --o: 50% 100%;" d="M0 0c-6-6-6-16 0-22 6 6 6 16 0 22Z" fill="#6f8a55"/>
          </g>
        {%- endfor -%}
        {%- comment -%} Star flowers: x, y, delay {%- endcomment -%}
        {%- assign flowers = '194,56,1.5|106,126,1.65|216,90,1.8|146,104,1.95|128,150,2.1' | split: '|' -%}
        {%- for f in flowers -%}
          {%- assign p = f | split: ',' -%}
          <g transform="translate({{ p[0] }} {{ p[1] }})">
            <g class="sfa-a sfa-bloom" style="--d: {{ p[2] }}s; --o: 50% 50%;">
              {%- for k in (0..4) -%}
                {%- assign a = k | times: 72 -%}
                <ellipse cx="0" cy="-7" rx="3.8" ry="7" transform="rotate({{ a }})" fill="#fffdf6" stroke="#dfe3cf" stroke-width="0.8"/>
              {%- endfor -%}
              <circle r="2.6" fill="#e9c75f"/>
            </g>
          </g>
        {%- endfor -%}
      </g>

    {%- when 'sandalwood' -%}
      <g class="sfa-sway" style="--sway-d: 2.8s;">
        <path class="sfa-a sfa-grow" style="--t: 1s;" pathLength="1" d="M160 228C160 202 156 184 160 152" fill="none" stroke="#8a5a3c" stroke-width="11" stroke-linecap="round"/>
        <path class="sfa-a sfa-grow" style="--d: 0.6s; --t: 0.6s;" pathLength="1" d="M159 176C146 166 136 156 128 140" fill="none" stroke="#8a5a3c" stroke-width="5" stroke-linecap="round"/>
        <path class="sfa-a sfa-grow" style="--d: 0.7s; --t: 0.6s;" pathLength="1" d="M161 166C176 156 186 146 194 130" fill="none" stroke="#8a5a3c" stroke-width="5" stroke-linecap="round"/>
        {%- assign canopy = '160,118,34,#7f8f5a,1.0|126,128,24,#93a36b,1.1|196,124,26,#6f7f4c,1.15|144,96,24,#8a9b62,1.25|180,94,22,#9aab72,1.3|160,80,18,#7a8a54,1.4' | split: '|' -%}
        {%- for c in canopy -%}
          {%- assign p = c | split: ',' -%}
          <circle class="sfa-a sfa-pop" style="--d: {{ p[4] }}s; --o: 50% 50%;" cx="{{ p[0] }}" cy="{{ p[1] }}" r="{{ p[2] }}" fill="{{ p[3] }}" fill-opacity="0.92"/>
        {%- endfor -%}
      </g>
      {%- comment -%} Aroma swirls drifting up (loop) {%- endcomment -%}
      <path class="sfa-a sfa-waft" style="--d: 1.8s;" pathLength="1" d="M132 70c-8-8 8-14 0-22s8-14 0-20" fill="none" stroke="#c49a74" stroke-width="2" stroke-linecap="round"/>
      <path class="sfa-a sfa-waft" style="--d: 2.4s;" pathLength="1" d="M162 64c-8-8 8-14 0-22s8-14 0-20" fill="none" stroke="#b88a63" stroke-width="2" stroke-linecap="round"/>
      <path class="sfa-a sfa-waft" style="--d: 3s;" pathLength="1" d="M192 70c-8-8 8-14 0-22s8-14 0-20" fill="none" stroke="#c49a74" stroke-width="2" stroke-linecap="round"/>

    {%- when 'ocean' -%}
      <circle class="sfa-a sfa-rise" style="--d: 0.9s;" cx="236" cy="70" r="22" fill="#f3cf86"/>
      <path class="sfa-a sfa-waft" style="--d: 1.4s;" pathLength="1" d="M40 84c34-10 66 8 104-4" fill="none" stroke="#3f8ea3" stroke-opacity="0.55" stroke-width="2" stroke-linecap="round"/>
      <path class="sfa-a sfa-waft" style="--d: 2s;" pathLength="1" d="M70 108c30-8 60 6 92-2" fill="none" stroke="#3f8ea3" stroke-opacity="0.45" stroke-width="2" stroke-linecap="round"/>
      <path class="sfa-a sfa-waft" style="--d: 2.6s;" pathLength="1" d="M150 60c26-8 50 4 74-2" fill="none" stroke="#3f8ea3" stroke-opacity="0.4" stroke-width="2" stroke-linecap="round"/>
      <path class="sfa-a sfa-bob" style="--d: 0s;" d="M-150 176q35-16 70 0t70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0V440H-150Z" fill="#9fd0db"/>
      <path class="sfa-a sfa-bob" style="--d: 0.2s; --bob: 4.4s;" d="M-170 194q35-14 70 0t70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0V440H-170Z" fill="#6fb3c4"/>
      <path class="sfa-a sfa-bob" style="--d: 0.4s; --bob: 3.8s;" d="M-160 212q35-12 70 0t70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0V440H-160Z" fill="#3f8ea3"/>

    {%- else -%}
      <g class="sfa-sway" style="--sway-d: 2s;">
        <path class="sfa-a sfa-grow" style="--t: 1s;" pathLength="1" d="M160 228C162 190 154 150 160 96" fill="none" stroke="#617246" stroke-width="3" stroke-linecap="round"/>
        {%- assign sprig = '160,196,-50,0.5|160,176,50,0.65|158,154,-48,0.8|160,134,48,0.95|159,114,-40,1.1|160,98,0,1.25' | split: '|' -%}
        {%- for leaf in sprig -%}
          {%- assign p = leaf | split: ',' -%}
          <g transform="translate({{ p[0] }} {{ p[1] }}) rotate({{ p[2] }})">
            <path class="sfa-a sfa-pop" style="--d: {{ p[3] }}s; --o: 50% 100%;" d="M0 0c-10-8-10-24 0-34 10 10 10 26 0 34Z" fill="#7e9160"/>
          </g>
        {%- endfor -%}
      </g>
  {%- endcase -%}
</svg>
{%- endif -%}

{% stylesheet %}
  /* ---------- Your artwork (art-*): vector parts on the designer's 1600x1800 canvas ---------- */
  .sfx {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    aspect-ratio: 1600 / 1800;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    /* Desktop: the plant sits in the right half; the ground spans the whole stage underneath. */
    .sfx {
      inset-inline: auto 4%;
      inset-block: 0;
      height: 100%;
    }
  }

  /* Ground (snippets/swick-frag-ground.liquid): an independent layer along the stage bottom.
     Its height matches the soil band of a 1600x1800 artwork drawn at stage height, so plants
     designed on that canvas stand exactly on it. */
  .sfx-ground {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 0;
    aspect-ratio: 1600 / 460;
    pointer-events: none;
  }

  .sfx-ground-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .sfx-ground {
      aspect-ratio: auto;
      height: calc(100% * 460 / 1800);
    }
  }

  .sfx-hill,
  .sfx-leaf,
  .sfx-bud,
  .sfx-petal,
  .sfx-centre,
  .sfx-bird {
    transform-box: view-box;
  }

  .sfx-sun {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  /* Stems of artwork scenes grow via an animated clip rectangle (scaled up from the soil). */
  .sfx-stem-reveal {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .swick-frag.is-ready .swick-frag__scene:not(.is-playing) .sfx-stem-reveal {
    transform: scaleY(0);
  }

  .meadow-ground {
    aspect-ratio: 1600 / 700;
  }

  @media screen and (min-width: 750px) {
    .meadow-ground {
      aspect-ratio: auto;
      height: calc(100% * 700 / 1800);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-playing .sfx-hill {
      animation: sfx-hill 1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both;
    }

    .is-playing .sfx-leaf {
      animation: sfx-unfurl 0.8s cubic-bezier(0.34, 1.3, 0.64, 1) var(--d, 0s) both;
    }

    .is-playing .sfx-bud {
      animation: sfa-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0s) both;
    }

    .is-playing .sfx-petal {
      animation: sfx-petal 0.6s cubic-bezier(0.34, 1.35, 0.64, 1) var(--d, 0s) both;
    }

    .is-playing .sfx-centre {
      animation: sfa-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0s) both;
    }

    .is-playing .sfx-stem-reveal {
      animation: sfx-stem 1.25s cubic-bezier(0.45, 0, 0.25, 1) 0.35s both;
    }

    .is-playing .sfx-sun {
      animation: sfx-sun 1.1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both;
    }

    .is-playing .sfx-bird {
      animation:
        sfx-bird-in 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both,
        sfx-bird-drift 6s ease-in-out calc(var(--d, 0s) + 1.4s) infinite;
    }
  }

  @keyframes sfx-hill {
    from { transform: translateY(140px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes sfx-petal {
    from { transform: scale(0) rotate(-28deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
  }

  @keyframes sfx-stem {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @keyframes sfx-sun {
    from { transform: translateY(60px) scale(0.7); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }

  @keyframes sfx-bird-in {
    from { transform: translate(-260px, 60px); opacity: 0; }
    to { transform: translate(0, 0); opacity: 1; }
  }

  @keyframes sfx-bird-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(34px, -16px); }
  }

  @keyframes sfx-unfurl {
    from { transform: scale(0.1) rotate(-12deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
  }

  .sfa {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sfa-ground {
    fill: rgb(0 0 0 / 0.08);
  }

  /* The shared hills/soil replace the drawn shadow ellipse. */
  .has-ground .sfa-ground {
    display: none;
  }

  /* Drawn plants on a scene with the shared ground: lift them so the stem base sits just
     inside the front soil line (the soil band is ~17.5% of the stage width tall). */
  .has-ground:not(.swick-frag__scene--art) .swick-frag__art {
    padding-block-end: 11.5%;
  }

  /* Initial (pre-play) state is hidden only once JS is ready, so no-JS shows the finished art. */
  .swick-frag.is-ready .swick-frag__scene:not(.is-playing) .sfa-a {
    opacity: 0;
  }

  .sfa-grow {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .sfa-pop,
  .sfa-bloom {
    transform-box: fill-box;
    transform-origin: var(--o, 50% 100%);
  }

  .sfa-sway {
    transform-box: view-box;
    transform-origin: 160px 230px;
    transform: rotate(0deg);
  }

  /* Promote the plant to its own layer before growth ends, so the sway starting doesn't re-rasterise it. */
  .is-playing .sfa-sway {
    will-change: transform;
  }

  .sfa-waft {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-playing .sfa-grow {
      animation: sfa-draw var(--t, 1s) cubic-bezier(0.5, 0, 0.3, 1) var(--d, 0s) both;
    }

    .is-playing .sfa-pop {
      animation: sfa-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0s) both;
    }

    .is-playing .sfa-bloom {
      animation: sfa-bloom 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) var(--d, 0s) both;
    }

    .is-playing .sfa-sway {
      animation: sfa-sway 5s ease-in-out var(--sway-d, 2.5s) infinite;
    }

    .is-playing .sfa-waft {
      animation: sfa-waft 3.4s ease-in-out var(--d, 0s) infinite;
    }

    .is-playing .sfa-rise {
      animation: sfa-rise 1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both;
    }

    .is-playing .sfa-bob {
      animation:
        sfa-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both,
        sfa-bob var(--bob, 4s) ease-in-out calc(var(--d, 0s) + 0.9s) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sfa-waft {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sfa-draw {
    from { stroke-dashoffset: 1; opacity: 1; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }

  @keyframes sfa-pop {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @keyframes sfa-bloom {
    from { transform: scale(0) rotate(-35deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
  }

  /* Starts and ends upright (0deg) so the hand-off from growing to swaying is seamless. */
  @keyframes sfa-sway {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-1.4deg); }
    75% { transform: rotate(1.4deg); }
  }

  @keyframes sfa-waft {
    0% { stroke-dashoffset: 1; opacity: 0; transform: translateY(10px); }
    25% { opacity: 1; }
    100% { stroke-dashoffset: -1; opacity: 0; transform: translateY(-16px); }
  }

  @keyframes sfa-rise {
    from { transform: translateY(44px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes sfa-bob {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-10px, 3px); }
  }
{% endstylesheet %}
