{%- doc -%}
  Thin-stroke (1.5px) monochrome icon set for Swick sections. Decorative: always aria-hidden.

  @param {string} icon - heart | plus | chevron-left | chevron-right | home | menu | new | bag | store | search | user | bottle | camphor | spray | linen | diya | oil | leaf | gift | percent | return | truck | bed | bath | sofa | car | check | close
  @param {string} [class] - Extra class for the svg element.

  @example
  {% render 'swick-icon', icon: 'bag' %}
{%- enddoc -%}

<svg
  class="swick-icon{% if class != blank %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-9.2-9.4C1.6 7.2 3.8 4 7.1 4c2 0 3.5 1.1 4.9 2.9C13.4 5.1 14.9 4 16.9 4c3.3 0 5.5 3.2 4.3 6.6C19.5 15.4 12 20 12 20Z"/>
    {%- when 'plus' -%}
      <path d="M12 4v16M4 12h16"/>
    {%- when 'chevron-left' -%}
      <path d="m15 5-7 7 7 7"/>
    {%- when 'chevron-right' -%}
      <path d="m9 5 7 7-7 7"/>
    {%- when 'home' -%}
      <path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1v-8.5Z"/>
    {%- when 'menu' -%}
      <path d="M3 8h7M3 12h5M3 16h7"/><circle cx="16" cy="11" r="4"/><path d="m19 14 2.5 2.5"/>
    {%- when 'new' -%}
      <path d="M11 3.5 4 10.5l8 8 7-7V4.5a1 1 0 0 0-1-1h-7Z"/><path d="M15.5 6v3M14 7.5h3"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'store' -%}
      <path d="M4 9.5 5.5 4h13L20 9.5M4 9.5h16M4 9.5c0 1.4 1.1 2.5 2.5 2.5S9 10.9 9 9.5c0 1.4 1.1 2.5 2.5 2.5h1c1.4 0 2.5-1.1 2.5-2.5 0 1.4 1.1 2.5 2.5 2.5S20 10.9 20 9.5"/><path d="M5.5 12v8h13v-8"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/>
    {%- when 'bottle' -%}
      <path d="M9.5 3h5v3.5c2 .8 3 2.4 3 4.5v8a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-8c0-2.1 1-3.7 3-4.5V3Z"/><path d="M6.5 13h11"/>
    {%- when 'camphor' -%}
      <rect x="5" y="9" width="14" height="10" rx="2"/><path d="M7.5 9 10 5.5h4L16.5 9M9 14h6"/>
    {%- when 'spray' -%}
      <rect x="8" y="10" width="8" height="11" rx="2"/><path d="M10 10V7.5h4V10M12 7.5V5h3M18 5h1M18.5 3l.7-.7M18.5 7l.7.7"/>
    {%- when 'linen' -%}
      <path d="M3 8.5c3-1.8 6-1.8 9 0s6 1.8 9 0v9c-3 1.8-6 1.8-9 0s-6-1.8-9 0v-9Z"/><path d="M3 13c3-1.8 6-1.8 9 0s6 1.8 9 0"/>
    {%- when 'diya' -%}
      <path d="M12 3.5c2 2.4 2 4.6 0 6.2-2-1.6-2-3.8 0-6.2Z"/><path d="M3.5 13h17c-.9 4.2-4.2 6.5-8.5 6.5S4.4 17.2 3.5 13Z"/><path d="M12 9.7V13"/>
    {%- when 'oil' -%}
      <path d="M12 3.5c3.4 4.6 6 8 6 11a6 6 0 0 1-12 0c0-3 2.6-6.4 6-11Z"/><path d="M9 15a3 3 0 0 0 3 3"/>
    {%- when 'gift' -%}
      <rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3 9h18M12 9v11M12 9c-1.5-3.5-5.5-4-5.5-1.5S12 9 12 9Zm0 0c1.5-3.5 5.5-4 5.5-1.5S12 9 12 9Z"/>
    {%- when 'bed' -%}
      <path d="M3 18.5V7M3 14h18v4.5M21 14v-2.5a2.5 2.5 0 0 0-2.5-2.5H11v5"/><circle cx="7" cy="11.2" r="1.8"/>
    {%- when 'bath' -%}
      <path d="M3 12h18v2a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-2Z"/><path d="M6 12V6a2 2 0 0 1 3.6-1.2M7 19l-1 2M17 19l1 2"/><path d="M9 6.5h2"/>
    {%- when 'sofa' -%}
      <path d="M5 11V8.5A2.5 2.5 0 0 1 7.5 6h9A2.5 2.5 0 0 1 19 8.5V11"/><path d="M3 13a2 2 0 0 1 4 0v1.5h10V13a2 2 0 0 1 4 0v4.5H3V13Z"/><path d="M5 17.5V19M19 17.5V19"/>
    {%- when 'car' -%}
      <path d="M4 15v-2.5l1.6-4.2A2 2 0 0 1 7.5 7h9a2 2 0 0 1 1.9 1.3l1.6 4.2V15"/><path d="M3 15h18v2.5H3z"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/><path d="M5.5 12h13"/>
    {%- when 'percent' -%}
      <path d="M11 3.5 4 10.5l8 8 7-7V4.5a1 1 0 0 0-1-1h-7Z"/><path d="m9.5 14.5 5-5"/><circle cx="10" cy="10" r="1"/><circle cx="14" cy="14" r="1"/>
    {%- when 'return' -%}
      <path d="M4.5 9A8 8 0 1 1 4 13.5"/><path d="M4.5 4.5V9H9"/><path d="m12 8 3.5 2v4L12 16l-3.5-2v-4L12 8Z"/><path d="m8.5 10 3.5 2 3.5-2M12 12v4"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.5v2.5h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- else -%}
      <path d="M5 19C5 11 10 5.5 19 5c0 9-5 14-14 14Z"/><path d="m5 19 7.5-7.5"/>
  {%- endcase -%}
</svg>
