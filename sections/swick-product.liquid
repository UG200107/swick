{%- comment -%}
  Swick — Snitch-style product page (mobile-first).
  Floating top bar (back / share / wishlist / bag), full-bleed swipe gallery, light title + bold price,
  offer strip, image swatches + boxed option buttons, delivery strip, pincode estimate,
  accordions, and a sticky full-width ADD TO BAG bar. Variant logic lives in assets/swick.js.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_variant
  if s.preselect_variant or product.has_only_default_variant
    assign current_variant = product.selected_or_first_available_variant
  endif

  assign price_variant = current_variant | default: product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign swatch_names = 'color,colour,scent,fragrance,flavour,flavor,variant'
  assign swatch_names = swatch_names | split: ','
  assign media_count = product.media.size
-%}

{% render 'swick-assets' %}

<swick-product
  class="swick-pdp{% if s.own_header_mobile %} swick-pdp--own-header{% endif %}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-preselect="{{ s.preselect_variant }}"
>
  <script type="application/json" data-swick-product>
    {{ product | json }}
  </script>

  {%- comment -%} Floating top bar — phones only {%- endcomment -%}
  <div class="swick-pdp__topbar" data-swick-topbar>
    <a href="{{ routes.collections_url }}" class="swick-pdp__topbtn" data-swick-back aria-label="{{ 'content.pagination.previous' | t | escape }}">
      {%- render 'swick-icon', icon: 'chevron-left' -%}
    </a>
    <div class="swick-pdp__topgroup">
      <button type="button" class="swick-pdp__topbtn" data-swick-share data-title="{{ product.title | escape }}" aria-label="Share">
        <svg class="swick-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8"/><path d="M8 11H6a1 1 0 0 0-1 1v7.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V12a1 1 0 0 0-1-1h-2"/></svg>
      </button>
      <swick-wishlist data-handle="{{ product.handle }}">
        <button type="button" class="swick-pdp__topbtn swick-pdp__wish" aria-pressed="false" aria-label="Save {{ product.title | escape }} to wishlist">
          {%- render 'swick-icon', icon: 'heart' -%}
        </button>
      </swick-wishlist>
      <a href="{{ routes.cart_url }}" class="swick-pdp__topbtn" data-swick-open-cart aria-label="{{ 'accessibility.cart' | t | escape }}">
        {%- render 'swick-icon', icon: 'bag' -%}
        <span class="swick-pdp__count" data-swick-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
    <span class="swick-visually-hidden" aria-live="polite" data-swick-share-status></span>
  </div>

  <div class="swick-pdp__layout">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="swick-pdp__gallery">
      <swick-slideshow class="swick-slideshow swick-pdp__slides" data-autoplay="0" role="region" aria-roledescription="carousel" aria-label="{{ product.title | escape }}">
        <ul class="swick-slideshow__track" data-swick-track role="list">
          {%- if media_count > 0 -%}
            {%- for media in product.media -%}
              <li class="swick-slideshow__slide swick-pdp__slide" data-swick-slide data-media-id="{{ media.id }}" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ media_count }}">
                {%- liquid
                  assign img_loading = 'lazy'
                  assign img_priority = 'auto'
                  if forloop.first
                    assign img_loading = 'eager'
                    assign img_priority = 'high'
                  endif
                -%}
                {{
                  media.preview_image
                  | image_url: width: 1500
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500',
                    sizes: '(min-width: 990px) 58vw, 100vw',
                    loading: img_loading,
                    fetchpriority: img_priority,
                    alt: media.alt,
                    class: 'swick-pdp__img'
                }}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="swick-slideshow__slide swick-pdp__slide swick-pdp__slide--ph" data-swick-slide aria-hidden="true">
              {%- render 'swick-icon', icon: 'bottle', class: 'swick-pdp__ph-icon' -%}
            </li>
          {%- endif -%}
        </ul>
        {%- if media_count > 1 -%}
          <button type="button" class="swick-slideshow__arrow swick-slideshow__arrow--prev swick-pdp__arrow" data-swick-prev aria-label="{{ 'accessibility.slideshow_previous' | t | escape }}">
            {%- render 'swick-icon', icon: 'chevron-left' -%}
          </button>
          <button type="button" class="swick-slideshow__arrow swick-slideshow__arrow--next swick-pdp__arrow" data-swick-next aria-label="{{ 'accessibility.slideshow_next' | t | escape }}">
            {%- render 'swick-icon', icon: 'chevron-right' -%}
          </button>
          <p class="swick-visually-hidden" aria-live="polite" data-swick-status data-template="{{ 'accessibility.slide_status' | t: index: '[index]', length: '[length]' | escape }}"></p>
        {%- endif -%}
      </swick-slideshow>
    </div>

    {%- comment -%} Info column {%- endcomment -%}
    <div class="swick-pdp__info">
      <div class="swick-pdp__head">
        {%- assign format_label = product.metafields.custom.format_type.value -%}
        {%- if format_label != blank -%}
          <p class="swick-pdp__format">{{ format_label | escape }}</p>
        {%- endif -%}
        <h1 class="swick-pdp__title">{{ product.title | escape }}</h1>

        <div class="swick-pdp__price-row">
          <span class="swick-pdp__price" data-swick-price>{{ price_variant.price | money_without_trailing_zeros }}</span>
          <s class="swick-pdp__compare" data-swick-compare {% unless price_variant.compare_at_price > price_variant.price %}hidden{% endunless %}>
            {{- price_variant.compare_at_price | money_without_trailing_zeros -}}
          </s>
          {%- liquid
            assign off = 0
            if price_variant.compare_at_price > price_variant.price
              assign off = price_variant.compare_at_price | minus: price_variant.price | times: 100 | divided_by: price_variant.compare_at_price
            endif
          -%}
          <span class="swick-pdp__off" data-swick-off {% if off == 0 %}hidden{% endif %}>{{ off }}% OFF</span>
        </div>
        {%- if s.tax_note != blank -%}
          <p class="swick-pdp__tax">{{ s.tax_note | escape }}</p>
        {%- endif -%}

        {%- if rating != blank and rating_count > 0 -%}
          <a href="#SwickReviews-{{ section.id }}" class="swick-pdp__rating" data-swick-open-reviews>
            <span class="swick-pdp__rating-score">{{ rating.rating | round: 1 }} ★</span>
            <span><strong>{{ rating_count }}</strong> Ratings</span>
          </a>
        {%- endif -%}
      </div>

      {%- if s.offer_text != blank -%}
        <p class="swick-pdp__offer">{{ s.offer_text | escape }}</p>
      {%- endif -%}

      {%- comment -%} Options {%- endcomment -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="swick-pdp__form" data-swick-form novalidate>
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-swick-variant-input>
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_index = forloop.index0
              assign option_name_down = option.name | downcase
              assign is_swatch = false
              if swatch_names contains option_name_down and media_count > 1
                assign is_swatch = true
              endif
              assign selected_value = ''
              if current_variant
                assign selected_value = current_variant.options[option_index]
              elsif option.values.size == 1
                assign selected_value = option.values.first
              endif
            -%}
            <fieldset class="swick-pdp__option" data-swick-option="{{ option_index }}" data-option-name="{{ option.name | escape }}">
              <legend class="swick-pdp__option-head">
                <span class="swick-pdp__option-label">
                  {%- if is_swatch -%}Selected {{ option.name | capitalize | escape }}{%- else -%}{{ option.name | capitalize | escape }}{%- endif -%}
                  <span class="swick-pdp__option-value" data-swick-option-value>
                    {%- if selected_value != blank -%}
                      <span aria-hidden="true"> · </span>{{ selected_value | escape }}
                    {%- endif -%}
                  </span>
                </span>
              </legend>
              {%- if forloop.last and s.guide_label != blank and s.guide_link != blank -%}
                <a href="{{ s.guide_link }}" class="swick-pdp__guide">{{ s.guide_label | escape }}</a>
              {%- endif -%}

              <div class="swick-pdp__values{% if is_swatch %} swick-pdp__values--swatch{% endif %}">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_img = nil
                    if is_swatch
                      for v in product.variants
                        if v.options[option_index] == value and v.featured_media
                          assign swatch_img = v.featured_media.preview_image
                          break
                        endif
                      endfor
                    endif
                  -%}
                  <button
                    type="button"
                    class="swick-pdp__value{% if swatch_img %} swick-pdp__value--img{% endif %}"
                    data-value="{{ value | escape }}"
                    aria-pressed="{% if value == selected_value %}true{% else %}false{% endif %}"
                    {% if swatch_img %}
                      aria-label="{{ option.name | escape }}: {{ value | escape }}"
                    {% endif %}
                  >
                    {%- if swatch_img -%}
                      {{
                        swatch_img
                        | image_url: width: 200
                        | image_tag: widths: '100, 200', sizes: '72px', loading: 'lazy', alt: '', class: 'swick-pdp__swatch-img'
                      }}
                    {%- else -%}
                      {{- value | escape -}}
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          <p class="swick-pdp__error" data-swick-option-error role="alert" hidden></p>
        {%- endunless -%}

        {%- comment -%} Sticky add-to-bag {%- endcomment -%}
        <div class="swick-pdp__atc-bar">
          <button
            type="submit"
            class="swick-pdp__atc"
            data-swick-atc
            data-label-add="{{ s.add_label | escape }}"
            data-label-adding="Adding…"
            data-label-added="{{ 'actions.added' | t | escape }}"
            data-label-soldout="{{ 'products.product.sold_out' | t | escape }}"
            {% if current_variant and current_variant.available == false %}
              disabled
            {% endif %}
            {% if product.available == false %}
              disabled
            {% endif %}
          >
            {%- if product.available == false or current_variant and current_variant.available == false -%}
              {{ 'products.product.sold_out' | t }}
            {%- else -%}
              {{ s.add_label | escape }}
            {%- endif -%}
          </button>
          <span class="swick-visually-hidden" aria-live="polite" data-swick-atc-status></span>
        </div>
      </form>

      {%- if s.delivery_strip != blank -%}
        <p class="swick-pdp__strip">{{ s.delivery_strip | escape }}</p>
      {%- endif -%}

      {%- comment -%} Delivery estimate {%- endcomment -%}
      {%- if s.show_pincode -%}
        <details class="swick-pdp__acc" open>
          <summary class="swick-pdp__acc-head swick-pdp__acc-head--bold">
            {{ s.pincode_heading | escape }}
            <span class="swick-pdp__acc-icon" aria-hidden="true"></span>
          </summary>
          <div class="swick-pdp__acc-body">
            <swick-pincode
              class="swick-pin"
              data-min-days="{{ s.delivery_min_days }}"
              data-max-days="{{ s.delivery_max_days }}"
              data-blocked="{{ s.blocked_prefixes | escape }}"
              data-cod="{{ s.cod_note | escape }}"
              data-select-msg="{{ s.select_option_msg | escape }}"
            >
              <form class="swick-pin__form" data-swick-pin-form novalidate>
                <label for="SwickPin-{{ section.id }}" class="swick-visually-hidden">Pincode</label>
                <input
                  id="SwickPin-{{ section.id }}"
                  class="swick-pin__input"
                  type="text"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  pattern="[1-9][0-9]{5}"
                  maxlength="6"
                  placeholder="Enter Pincode"
                  data-swick-pin-input
                >
                <button type="submit" class="swick-pin__check">Check</button>
              </form>
              <p class="swick-pin__msg" data-swick-pin-msg role="status" hidden></p>
            </swick-pincode>
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Accordions {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="swick-pdp__app">{% render block %}</div>
          {%- when 'accordion' -%}
            {%- liquid
              assign b = block.settings
              assign body = ''
              case b.source
                when 'description'
                  assign body = product.description
                when 'how_to_use'
                  assign body = product.metafields.custom.how_to_use.value | escape | newline_to_br
                when 'custom'
                  assign body = b.content
                when 'page'
                  assign body = b.page.content
              endcase

              assign top = product.metafields.custom.top_notes.value
              assign heart = product.metafields.custom.heart_notes.value
              assign base = product.metafields.custom.base_notes.value
              assign intensity = product.metafields.custom.intensity_level.value
              assign has_notes = false
              if top != blank or heart != blank or base != blank or intensity != blank
                assign has_notes = true
              endif
              assign show = true
              if b.source == 'scent_notes' and has_notes == false
                assign show = false
              elsif b.source != 'scent_notes' and b.source != 'reviews' and body == blank
                assign show = false
              endif
            -%}
            {%- if show -%}
              <details
                class="swick-pdp__acc"
                {% if b.source == 'reviews' %}
                  id="SwickReviews-{{ section.id }}"
                {% endif %}
                {% if b.open %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="swick-pdp__acc-head">
                  {{ b.title | escape }}
                  <span class="swick-pdp__acc-icon" aria-hidden="true"></span>
                </summary>
                <div class="swick-pdp__acc-body swick-pdp__rte">
                  {%- case b.source -%}
                    {%- when 'scent_notes' -%}
                      <dl class="swick-notes">
                        {%- if top != blank -%}<div class="swick-notes__row"><dt>Top</dt><dd>{{ top | escape }}</dd></div>{%- endif -%}
                        {%- if heart != blank -%}<div class="swick-notes__row"><dt>Heart</dt><dd>{{ heart | escape }}</dd></div>{%- endif -%}
                        {%- if base != blank -%}<div class="swick-notes__row"><dt>Base</dt><dd>{{ base | escape }}</dd></div>{%- endif -%}
                        {%- if intensity != blank -%}
                          {%- assign level = intensity | at_least: 1 | at_most: 5 -%}
                          <div class="swick-notes__row">
                            <dt>Intensity</dt>
                            <dd>
                              <span class="swick-notes__bar" role="img" aria-label="{{ level }} out of 5">
                                {%- for i in (1..5) -%}<span class="swick-notes__pip{% if i <= level %} is-on{% endif %}"></span>{%- endfor -%}
                              </span>
                            </dd>
                          </div>
                        {%- endif -%}
                      </dl>
                    {%- when 'reviews' -%}
                      {%- if rating != blank and rating_count > 0 -%}
                        <p class="swick-pdp__reviews-sum"><strong>{{ rating.rating | round: 1 }} ★</strong> from {{ rating_count }} ratings</p>
                      {%- else -%}
                        <p>No reviews yet. Be the first to share how it fits your ritual.</p>
                      {%- endif -%}
                      {{ b.content }}
                    {%- else -%}
                      {{ body }}
                  {%- endcase -%}
                </div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</swick-product>

{% stylesheet %}
  .swick-pdp {
    display: block;
    color: var(--swick-ink, #111);
    background-color: var(--swick-surface, #fff);
  }

  /* ---------- Top bar (phones) ---------- */
  .swick-pdp__topbar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    body:has(.swick-pdp--own-header) .shopify-section-group-header-group {
      display: none;
    }

    body:has(.swick-pdp) .swick-bnav {
      display: none;
    }

    body:has(.swick-pdp) {
      padding-block-end: calc(84px + env(safe-area-inset-bottom));
    }

    .swick-pdp--own-header .swick-pdp__topbar {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 15;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
      padding-inline: 6px;
      background-color: transparent;
      transition: background-color var(--animation-speed-medium, 0.15s) ease, box-shadow var(--animation-speed-medium, 0.15s) ease;
    }

    .swick-pdp__topbar.is-solid {
      background-color: #fff;
      box-shadow: 0 1px 0 var(--swick-line, #e4e4e4);
    }

    /* Over the image the right-hand icons stack vertically, like the reference. */
    .swick-pdp__topbar:not(.is-solid) {
      align-items: flex-start;
      padding-block-start: 8px;
    }

    .swick-pdp__topbar:not(.is-solid) .swick-pdp__topgroup {
      flex-direction: column;
    }
  }

  .swick-pdp__topgroup {
    display: flex;
    align-items: center;
  }

  .swick-pdp__topbtn {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--swick-ink, #111);
    text-decoration: none;
    cursor: pointer;
  }

  .swick-pdp__topbtn svg {
    width: 24px;
    height: 24px;
  }

  .swick-pdp__wish[aria-pressed='true'] svg path {
    fill: var(--swick-accent, #c27d48);
    stroke: var(--swick-accent, #c27d48);
  }

  .swick-pdp__count {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-end: 4px;
    min-width: 16px;
    height: 16px;
    padding-inline: 4px;
    box-sizing: border-box;
    border-radius: 999px;
    background-color: #617246;
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }

  .swick-pdp__count[hidden] {
    display: none;
  }

  /* ---------- Layout ---------- */
  .swick-pdp__layout {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .swick-pdp__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 40px;
      padding: 24px 48px 48px;
      align-items: start;
    }

    .swick-pdp__info {
      position: sticky;
      inset-block-start: 24px;
    }
  }

  /* ---------- Gallery ---------- */
  .swick-slideshow.swick-pdp__slides {
    --swick-ratio: 3 / 4;
    background-color: var(--swick-soft, #f2f2f2);
  }

  .swick-pdp__slide {
    background-color: var(--swick-soft, #f2f2f2);
  }

  .swick-pdp__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .swick-pdp__slide--ph {
    display: grid;
    place-items: center;
    color: #a3a3a3;
  }

  .swick-pdp__ph-icon {
    width: 34%;
    height: auto;
    stroke-width: 0.8;
  }

  .swick-pdp__slides .swick-pdp__arrow {
    color: var(--swick-ink, #111);
    filter: none;
  }

  /* ---------- Info ---------- */
  .swick-pdp__head {
    padding: 18px var(--swick-gutter, 16px) 0;
  }

  @media screen and (min-width: 750px) {
    .swick-pdp__head {
      padding-inline: 0;
    }
  }

  .swick-pdp__format {
    margin: 0 0 4px;
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--swick-muted, #6b6b6b);
  }

  .swick-pdp__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    color: var(--swick-ink, #111);
  }

  .swick-pdp__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-start: 4px;
    font-family: var(--font-body--family);
  }

  .swick-pdp__price {
    font-size: 18px;
    font-weight: 700;
  }

  .swick-pdp__compare {
    font-size: 14px;
    color: var(--swick-muted, #6b6b6b);
  }

  .swick-pdp__off {
    font-size: 13px;
    font-weight: 600;
    color: var(--swick-accent, #c27d48);
  }

  .swick-pdp__compare[hidden],
  .swick-pdp__off[hidden] {
    display: none;
  }

  .swick-pdp__tax {
    margin: 4px 0 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 300;
    color: var(--swick-muted, #6b6b6b);
  }

  .swick-pdp__rating {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-block-start: 16px;
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 300;
    color: var(--swick-ink, #111);
    text-decoration: none;
  }

  .swick-pdp__rating-score {
    padding: 2px 6px;
    background-color: var(--swick-ink, #111);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  .swick-pdp__offer {
    margin: 18px var(--swick-gutter, 16px) 0;
    padding: 12px;
    background-color: var(--swick-soft, #f2f2f2);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 300;
    color: var(--swick-ink, #111);
  }

  /* ---------- Options ---------- */
  .swick-pdp__form {
    padding-inline: var(--swick-gutter, 16px);
  }

  @media screen and (min-width: 750px) {
    .swick-pdp__form,
    .swick-pdp__offer {
      margin-inline: 0;
      padding-inline: 0;
    }

    .swick-pdp__offer {
      padding-inline: 12px;
    }
  }

  .swick-pdp__option {
    position: relative;
    margin: 20px 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .swick-pdp__option-head {
    padding: 0;
    margin-block-end: 10px;
  }

  .swick-pdp__option-label {
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 300;
    color: var(--swick-ink-soft, #3a3a3a);
  }

  .swick-pdp__option-value {
    font-weight: 500;
    color: var(--swick-ink, #111);
  }

  .swick-pdp__guide {
    position: absolute;
    inset-block-start: -2px;
    inset-inline-end: 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--swick-ink, #111);
  }

  .swick-pdp__values {
    display: flex;
    flex-wrap: wrap;
  }

  .swick-pdp__value {
    min-width: 48px;
    min-height: 44px;
    margin: 0 -1px -1px 0;
    padding: 10px 14px;
    border: 1px solid #cfcfcf;
    background: #fff;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 400;
    color: var(--swick-ink, #111);
    cursor: pointer;
  }

  .swick-pdp__value[aria-pressed='true'] {
    position: relative;
    z-index: 1;
    border-color: var(--swick-ink, #111);
    background-color: var(--swick-ink, #111);
    color: #fff;
  }

  .swick-pdp__value.is-unavailable {
    color: #a8a8a8;
    background-image: linear-gradient(to top right, transparent calc(50% - 0.5px), #cfcfcf calc(50% - 0.5px), #cfcfcf calc(50% + 0.5px), transparent calc(50% + 0.5px));
  }

  .swick-pdp__value[aria-pressed='true'].is-unavailable {
    background-image: none;
    color: #fff;
  }

  .swick-pdp__values--swatch {
    gap: 8px;
  }

  .swick-pdp__value--img {
    width: 52px;
    height: 72px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-color: transparent;
    background-color: var(--swick-soft, #f2f2f2);
  }

  .swick-pdp__value--img[aria-pressed='true'] {
    border-color: var(--swick-ink, #111);
    background-color: var(--swick-soft, #f2f2f2);
  }

  .swick-pdp__swatch-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .swick-pdp__value:focus-visible {
    outline: 2px solid var(--swick-accent, #c27d48);
    outline-offset: 2px;
  }

  .swick-pdp__error {
    margin: 10px 0 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    color: #b3261e;
  }

  .swick-pdp__form.is-shaking .swick-pdp__option:not(.is-done) .swick-pdp__values {
    animation: swick-shake 0.35s ease;
  }

  @keyframes swick-shake {
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .swick-pdp__form.is-shaking .swick-pdp__option .swick-pdp__values {
      animation: none;
    }
  }

  /* ---------- Sticky add to bag ---------- */
  .swick-pdp__atc-bar {
    margin-block-start: 20px;
  }

  @media screen and (max-width: 749px) {
    .swick-pdp__atc-bar {
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 15;
      margin: 0;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: linear-gradient(to top, #fff 60%, rgb(255 255 255 / 0));
    }
  }

  .swick-pdp__atc {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    border: 0;
    border-radius: 0;
    background-color: var(--swick-ink, #111);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .swick-pdp__atc:disabled {
    background-color: #9a9a9a;
    cursor: not-allowed;
  }

  .swick-pdp__atc.is-added {
    background-color: var(--swick-accent, #c27d48);
  }

  .swick-pdp__atc:focus-visible {
    outline: 2px solid var(--swick-accent, #c27d48);
    outline-offset: 2px;
  }

  /* ---------- Strip + accordions ---------- */
  .swick-pdp__strip {
    margin: 24px 0 0;
    padding: 14px 16px;
    background-color: var(--swick-soft, #f2f2f2);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 300;
    text-align: center;
    color: var(--swick-ink, #111);
  }

  .swick-pdp__acc {
    margin-inline: 4px;
    border-block-end: 1px solid var(--swick-line, #e4e4e4);
  }

  .swick-pdp__acc:first-of-type {
    border-block-start: 1px solid var(--swick-line, #e4e4e4);
    margin-block-start: 24px;
  }

  .swick-pdp__acc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 12px 12px;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 300;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .swick-pdp__acc-head::-webkit-details-marker {
    display: none;
  }

  .swick-pdp__acc-head--bold {
    font-weight: 700;
  }

  .swick-pdp__acc-icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .swick-pdp__acc-icon::before,
  .swick-pdp__acc-icon::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline: 0;
    height: 1.5px;
    margin-block-start: -0.75px;
    background-color: currentColor;
    transition: transform var(--animation-speed-medium, 0.15s) ease;
  }

  .swick-pdp__acc-icon::after {
    transform: rotate(90deg);
  }

  .swick-pdp__acc[open] .swick-pdp__acc-icon::after {
    transform: rotate(0deg);
  }

  .swick-pdp__acc-head:focus-visible {
    outline: 2px solid var(--swick-ink, #111);
    outline-offset: -2px;
  }

  .swick-pdp__acc-body {
    padding: 0 12px 20px;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--swick-ink-soft, #3a3a3a);
  }

  .swick-pdp__rte > :first-child {
    margin-block-start: 0;
  }

  .swick-pdp__rte > :last-child {
    margin-block-end: 0;
  }

  /* Pincode */
  .swick-pin__form {
    display: flex;
    align-items: stretch;
    border: 1px solid #9a9a9a;
  }

  .swick-pin__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 0 16px;
    border: 0;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 300;
    color: var(--swick-ink, #111);
  }

  .swick-pin__input:focus-visible {
    outline: 2px solid var(--swick-ink, #111);
    outline-offset: -2px;
  }

  .swick-pin__check {
    flex: 0 0 auto;
    min-width: 88px;
    padding: 0 16px;
    border: 0;
    background: none;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--swick-accent, #c27d48);
    cursor: pointer;
  }

  .swick-pin__msg {
    margin: 14px 0 0;
    padding: 12px 16px;
    background-color: var(--swick-soft, #f2f2f2);
    font-size: 14px;
    color: var(--swick-ink, #111);
  }

  .swick-pin__msg.is-warn {
    background-color: #f3c9b9;
  }

  .swick-pin__msg[hidden] {
    display: none;
  }

  /* Scent notes */
  .swick-notes {
    margin: 0;
  }

  .swick-notes__row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 8px;
    padding-block: 6px;
  }

  .swick-notes__row dt {
    font-weight: 500;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--swick-ink, #111);
  }

  .swick-notes__row dd {
    margin: 0;
  }

  .swick-notes__bar {
    display: inline-flex;
    gap: 4px;
  }

  .swick-notes__pip {
    width: 22px;
    height: 6px;
    background-color: var(--swick-line, #e4e4e4);
  }

  .swick-notes__pip.is-on {
    background-color: var(--swick-accent, #c27d48);
  }

  .swick-pdp__app {
    padding-inline: var(--swick-gutter, 16px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swick product",
  "tag": "section",
  "class": "swick-pdp-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "own_header_mobile",
      "label": "Use floating top bar on phones",
      "info": "Hides the theme header on this page on phones and shows back, share, wishlist and bag icons over the gallery.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "preselect_variant",
      "label": "Preselect first available variant",
      "info": "Off: shoppers must pick each option before adding to bag.",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "*MRP inclusive of all taxes"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer strip",
      "default": "Get 10% off on prepaid UPI orders"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add button label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "guide_label",
      "label": "Guide link label",
      "info": "Shown next to the last option, e.g. Size guide or How to use.",
      "default": "Size guide"
    },
    {
      "type": "url",
      "id": "guide_link",
      "label": "Guide link"
    },
    {
      "type": "text",
      "id": "delivery_strip",
      "label": "Delivery strip",
      "default": "FREE delivery on orders above ₹699"
    },
    {
      "type": "header",
      "content": "Delivery estimate"
    },
    {
      "type": "checkbox",
      "id": "show_pincode",
      "label": "Show pincode check",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "This gives an estimated delivery window from the days below. It does not query a courier."
    },
    {
      "type": "text",
      "id": "pincode_heading",
      "label": "Heading",
      "default": "Delivery"
    },
    {
      "type": "range",
      "id": "delivery_min_days",
      "label": "Fastest delivery",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "d",
      "default": 3
    },
    {
      "type": "range",
      "id": "delivery_max_days",
      "label": "Slowest delivery",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "d",
      "default": 6
    },
    {
      "type": "text",
      "id": "blocked_prefixes",
      "label": "Non-serviceable pincode prefixes",
      "info": "Comma-separated starts of pincodes you can't ship to, e.g. 744, 7371."
    },
    {
      "type": "text",
      "id": "cod_note",
      "label": "Extra note after a successful check",
      "default": "Cash on Delivery available"
    },
    {
      "type": "text",
      "id": "select_option_msg",
      "label": "Message when no option is selected",
      "info": "[option] is replaced with the option name.",
      "default": "Please select your [option] to check delivery date"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Description"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "options": [
            { "value": "description", "label": "Product description" },
            { "value": "scent_notes", "label": "Scent notes (custom metafields)" },
            { "value": "how_to_use", "label": "How to use (custom.how_to_use)" },
            { "value": "reviews", "label": "Reviews summary" },
            { "value": "page", "label": "Page" },
            { "value": "custom", "label": "Custom text" }
          ],
          "default": "description"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page",
          "info": "Used when Content is Page."
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "info": "For Custom text, and shown under the summary for Reviews."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swick product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Description", "source": "description" } },
        { "type": "accordion", "settings": { "title": "Scent notes", "source": "scent_notes" } },
        { "type": "accordion", "settings": { "title": "How to use", "source": "how_to_use" } },
        { "type": "accordion", "settings": { "title": "Reviews", "source": "reviews" } },
        { "type": "accordion", "settings": { "title": "Returns", "source": "custom", "content": "<p>Unopened products can be returned within 7 days of delivery. Damaged in transit? Share a photo within 48 hours and we'll replace it.</p>" } }
      ]
    }
  ]
}
{% endschema %}
